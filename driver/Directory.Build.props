<Project>
  <!-- Use the NuGet WDK/SDK when driver\packages has been restored (see packages.config);
       otherwise the installed WDK is used. -->
  <PropertyGroup>
    <WdkNuGetDir>$(MSBuildThisFileDirectory)packages\</WdkNuGetDir>
  </PropertyGroup>
  <Import Project="$(WdkNuGetDir)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(WdkNuGetDir)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(WdkNuGetDir)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(WdkNuGetDir)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(WdkNuGetDir)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(WdkNuGetDir)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')" />
  <!-- ARM64: NuGet WDK/SDK, globbed so the exact package/props spelling cannot miss.
       Wildcard imports skip cleanly when nothing matches (no driver\packages restored:
       the installed WDK is used then). Item lists like @(X) or @(X->Count()) must NOT be
       used in Import/Project or its Condition: they are illegal in the property-evaluation
       pass (MSB4099) and are imported literally when empty (MSB4019). -->
  <Import Project="$(WdkNuGetDir)Microsoft.Windows.WDK.ARM64.*\build\native\Microsoft.Windows.WDK*.props" Condition="Exists('$(WdkNuGetDir)Microsoft.Windows.WDK.ARM64.*\build\native\Microsoft.Windows.WDK*.props') and '$(Platform)' == 'ARM64'" />
  <Import Project="$(WdkNuGetDir)Microsoft.Windows.SDK.CPP.arm64.*\build\native\Microsoft.Windows.SDK.cpp*.props" Condition="Exists('$(WdkNuGetDir)Microsoft.Windows.SDK.CPP.arm64.*\build\native\Microsoft.Windows.SDK.cpp*.props') and '$(Platform)' == 'ARM64'" />
</Project>
